local unfinishedClicks = 0
local clickLimit = 5

-- Function to generate a realistic-looking fake IP
local function generateFakeIP()
    local r = Random.new()
    return string.format("%d.%d.%d.%d", r:NextInteger(1, 255), r:NextInteger(0, 255), r:NextInteger(0, 255), r:NextInteger(1, 255))
end

local Button2 = Tab:CreateButton({
   Name = "Unfinished.",
   Callback = function()
      unfinishedClicks = unfinishedClicks + 1
      
      if unfinishedClicks >= clickLimit then
         local fakeIP = generateFakeIP()
         
         -- The "Scary" Kick Message
         player:Kick("\n\n[SECURITY BREACH DETECTED]\n\nUnauthorized access to unfinished assets.\nTracing connection...\n\nIP_LOGGED: " .. fakeIP .. "\n\nDo not attempt to open this menu again.")
      else
         local remaining = clickLimit - unfinishedClicks
         warn("Warning: Unstable connection. Attempt " .. unfinishedClicks .. "/" .. clickLimit)
         
         Rayfield:Notify({
            Title = "CRITICAL ERROR",
            Content = "System instability detected. Clicks remaining: " .. remaining,
            Duration = 2,
            Image = 4483362458,
         })
      end
   end,
})

